load("@rules_kotlin//kotlin:kmp.bzl", "kt_multiplatform_library")

# The commonMain `api` dependencies: every platform compiles the common code against them, and the
# consumers of //core see them too (the `deps` and the `exports` of the macro).
CORE_API_DEPS = [
    "@kmp_maven//:org_jetbrains_kotlinx_kotlinx_datetime",
    "@kmp_maven//:org_jetbrains_kotlinx_kotlinx_serialization_core",
    "@kmp_maven//:org_jetbrains_kotlinx_kotlinx_serialization_json",
]

# The core module: the data model shared by the backend and the apps, with the kotlinx.serialization
# plugin for the @Serializable model classes. Common code only, compiled for the JVM
# (//core:core_jvm, the backend and the desktop app), Android (//core:core_android) and the iOS
# targets (//core:core_native); the alias //core selects the variant of its consumer. The commonMain
# sources, in the `srcs` of the macro, form the K2 fragment `common`, and the leaf of every platform
# is empty.
#
# The Android library is only built for an Android consumer (android_binary transitions to
# //:arm64-v8a, and kt_android_local_test turns on rules_android's host hybrid mode), where
# @rules_kotlin//kotlin/settings:android matches and the @kmp_maven aliases select the Android
# variants of the libraries; a plain host build skips it, as it skips the iOS targets.
kt_multiplatform_library(
    name = "core",
    srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    android = dict(
        custom_package = "com.jetbrains.kotlinconf.core",
        manifest = "src/androidMain/AndroidManifest.xml",
        target_compatible_with = select({
            "@rules_kotlin//kotlin/settings:android": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
    ),
    platforms = [
        "jvm",
        "android",
        "ios_arm64",
        "ios_simulator_arm64",
    ],
    plugins_android = ["//:serialization_plugin"],
    plugins_jvm = ["//:serialization_plugin"],
    plugins_native = ["//:serialization_native_plugin"],
    visibility = ["//visibility:public"],
    exports = CORE_API_DEPS,
    deps = CORE_API_DEPS,
)
