load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_apple//apple:ios.bzl", "ios_unit_test")
load("@rules_kotlin//kotlin:kmp.bzl", "kt_multiplatform_library", "kt_multiplatform_test")
load("//:version.bzl", "VERSION_CODE", "VERSION_NAME")
load("//bazel:compose_resources.bzl", "compose_resources")

# The shared module of the apps: the screens, the services, the storage and the Metro dependency
# graph, a Kotlin Multiplatform library for the JVM, Android and the iOS targets, with the Compose,
# kotlinx.serialization and Metro compiler plugins.

KMP = "@kmp_maven//:"

# The commonMain `api` dependencies: the consumers of the module (the apps) see them too
# (the `exports` of the macro).
SHARED_API_DEPS = [
    "//core",
    "//app/ui-components:ui_components",
] + [
    KMP + name
    for name in [
        "org_jetbrains_compose_runtime_runtime",
        "org_jetbrains_compose_foundation_foundation",
        "org_jetbrains_compose_animation_animation",
        "org_jetbrains_compose_components_components_resources",
        "io_ktor_ktor_client_logging",
        "io_ktor_ktor_serialization_kotlinx_json",
        "io_ktor_ktor_client_content_negotiation",
        "io_ktor_ktor_utils",
        "io_github_mirzemehdi_kmpnotifier",
    ]
]

# The commonMain `implementation` dependencies (with the Metro runtime of the Metro compiler plugin).
SHARED_DEPS = [
    KMP + name
    for name in [
        "org_jetbrains_compose_ui_ui_tooling_preview",
        "dev_zacsweers_metro_runtime",
        "dev_zacsweers_metro_metrox_viewmodel_compose",
        "org_jetbrains_kotlinx_kotlinx_datetime",
        "org_jetbrains_androidx_lifecycle_lifecycle_runtime_compose",
        "org_jetbrains_androidx_navigation3_navigation3_ui",
        "org_jetbrains_androidx_lifecycle_lifecycle_viewmodel_navigation3",
        "io_ktor_ktor_client_core",
        "com_mikepenz_aboutlibraries_core",
        "io_coil_kt_coil3_coil_compose",
        "com_russhwolf_multiplatform_settings",
        "com_russhwolf_multiplatform_settings_serialization",
        "com_russhwolf_multiplatform_settings_make_observable",
        "com_russhwolf_multiplatform_settings_coroutines",
        "com_doist_x_normalize",
        "com_squareup_okio_okio",
    ]
]

# The deps of the Android compilation, on top of the ones of the common code.
ANDROID_DEPS = [
    KMP + name
    for name in [
        "com_caverock_androidsvg_aar",
        "androidx_preference_preference_ktx",
        "io_ktor_ktor_client_okhttp",
        "dev_zacsweers_metro_metrox_android",
    ]
]

# The deps of the iOS compilations, on top of the ones of the common code.
IOS_DEPS = [
    KMP + name
    for name in [
        "org_jetbrains_kotlinx_kotlinx_coroutines_core",
        "io_ktor_ktor_client_darwin",
    ]
]

# The deps of the JVM compilation, on top of the ones of the common code.
JVM_DEPS = [
    KMP + name
    for name in [
        "io_ktor_ktor_client_okhttp",
        "org_slf4j_slf4j_nop",
    ]
]

# The compiler plugins of every platform compilation: Metro goes first (the Metro Gradle plugin
# orders it before the Compose compiler with -Xcompiler-plugin-order), followed by the Compose and
# kotlinx.serialization plugins of the platform's Kotlin compiler release.
JVM_PLUGINS = [
    "//:metro_plugin",
    "//:compose_plugin",
    "//:serialization_plugin",
]

NATIVE_PLUGINS = [
    "//:metro_native_plugin",
    "//:compose_native_plugin",
    "//:serialization_native_plugin",
]

# The `app_version` string of the About screen, "<version> (<build>)", from //:version.bzl: a
# generated resource file of the composeResources directory.
write_file(
    name = "version_xml",
    out = "src/commonMain/composeResources/values/version.xml",
    content = [
        "<resources>",
        '    <string name="app_version">%s (%s)</string>' % (VERSION_NAME, VERSION_CODE),
        "</resources>",
        "",
    ],
)

# The Compose resources of the shared module, an internal `Res` class: the strings (values,
# values-de), drawables (drawable, drawable-dark), fonts and the raw files (files/aboutlibraries.json,
# the export of the AboutLibraries Gradle plugin, committed; refresh it by hand when the dependencies
# change).
compose_resources(
    name = "shared_resources",
    srcs = glob(["src/commonMain/composeResources/**"]) + [":version_xml"],
    actual_srcs = [
        "android",
        "non_android",
    ],
    package = "org.jetbrains.kotlinconf.generated.resources",
    resources_dir = "src/commonMain/composeResources",
    visibility = ["//app:__subpackages__"],
)

# The sources of the module, along the hierarchy and aliases of kt_multiplatform_library: each
# platform compiles the fragments of the groups, aliases and platform leaves that cover it, refined
# by platform inclusion.

# Every platform (the `srcs` of the macro): the commonMain code, the generated sources of the
# resources (the Res class, its accessors and the `expect` collectors), and Gradle's nonWebMain, the
# file storage of every platform of this build (the web one, which this build does not have, holds
# the browser integration).
COMMON = glob(["src/commonMain/kotlin/**/*.kt"]) + [":shared_resources_common_srcs"]

NON_WEB = glob(["src/nonWebMain/kotlin/**/*.kt"])

# The JVM and the native targets, not Android: Gradle's nonAndroidMain, the SVG decoder of the Skia
# platforms, listed in `srcs_non_android` of the `non_android` alias.
NON_ANDROID = glob(["src/nonAndroidMain/kotlin/**/*.kt"])

# The sources of the JVM, Android and iOS: Gradle's jvmMain, androidMain and iosMain, the `actual`
# declarations of the `expect` ones of the common code.
JVM = glob(["src/jvmMain/kotlin/**/*.kt"])

ANDROID = glob(["src/androidMain/kotlin/**/*.kt"])

IOS = glob(["src/iosMain/kotlin/**/*.kt"])

# The generated sources of the resources join the `srcs` of the macro (the Res class, its accessors
# and the `expect` collectors) and `srcs_android` and `srcs_non_android` (the `actual` collectors,
# partitioned across the two disjoint branches below `common` via distinct `actual_srcs` filegroups);
# the resource tree goes on the JVM classpath as a jar and into the Android assets, where the
# resources runtime reads it. The alias //app/shared selects the variant of its consumer.
#
# The fragments the macro declares per targeted group, alias and platform leaf, refined by platform
# inclusion:
#   COMMON + NON_WEB (the macro's `srcs`)             common
#   NON_ANDROID + :shared_resources_non_android_srcs  non_android, refines common
#   IOS (`srcs_ios`)                                  ios, refines non_android
# JVM (`srcs_jvm`) and ANDROID + :shared_resources_android_srcs (`srcs_android`) are the leaves
# `jvm` (refining non_android) and `android` (refining common); the leaves of the konan targets are
# empty (refining ios). The `actual` declarations are in the leaves and the fragments below `common`,
# so every platform compiles one `actual` per `expect`.
#
# The Android library is only built for an Android consumer (android_binary transitions to
# //:arm64-v8a, and kt_android_local_test turns on rules_android's host hybrid mode), where
# @rules_kotlin//kotlin/settings:android matches and the @kmp_maven aliases select the Android
# variants of the libraries: its own deps (androidsvg, preference-ktx, metrox-android) have no
# other variant, and Compose has to be the Android one, so a plain host build of the package skips
# it, as it skips the iOS targets. Its manifest (the alarm receiver of the local notifications and
# its permissions) is merged into the one of //app/androidApp with the manifests of the other
# libraries.
kt_multiplatform_library(
    name = "shared",
    srcs = COMMON + NON_WEB,
    aliases = {
        "non_android": [
            "jvm",
            "ios_arm64",
            "ios_simulator_arm64",
        ],
    },
    android = dict(
        assets = [":shared_resources_files"],
        assets_dir = "shared_resources/resources",
        custom_package = "org.jetbrains.kotlinconf",
        exports_manifest = 1,
        manifest = "src/androidMain/AndroidManifest.xml",
        target_compatible_with = select({
            "@rules_kotlin//kotlin/settings:android": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
    ),
    deps_android = ANDROID_DEPS,
    deps_ios = IOS_DEPS,
    deps_jvm = JVM_DEPS,
    jvm = dict(
        resource_jars = [":shared_resources_jar"],
    ),
    platforms = [
        "jvm",
        "android",
        "ios_arm64",
        "ios_simulator_arm64",
    ],
    plugins_android = JVM_PLUGINS,
    plugins_jvm = JVM_PLUGINS,
    plugins_native = NATIVE_PLUGINS,
    srcs_android = ANDROID + [":shared_resources_android_srcs"],
    srcs_ios = IOS,
    srcs_jvm = JVM,
    srcs_non_android = NON_ANDROID + [":shared_resources_non_android_srcs"],
    visibility = ["//visibility:public"],
    exports = SHARED_API_DEPS,
    deps = SHARED_API_DEPS + SHARED_DEPS,
)

# The tests of the JVM, Android and iOS simulator: Gradle's commonTest, run on all three platforms,
# and jvmTest, on the JVM only. kt_multiplatform_test declares `tests_jvm` (a kt_jvm_test),
# `tests_android` (a kt_android_local_test, selecting the Android variants on the host through
# @rules_kotlin//kotlin/settings:android), `tests_ios_lib` (a kt_native_xctest_library) and
# `tests_ios` (an ios_unit_test running in the iOS simulator on macOS arm64, skipped elsewhere),
# each a friend of the library of its platform (`shared_jvm`, `shared_android`, `shared_native`),
# and the test_suite `tests`. The device target ios_arm64 is not listed: its tests would need a
# signed bundle.
TEST_DEPS = SHARED_API_DEPS + SHARED_DEPS + [
    KMP + name
    for name in [
        "com_russhwolf_multiplatform_settings_test",
        "org_jetbrains_kotlinx_kotlinx_coroutines_test",
    ]
]

# kotlin.test on the JVM and Android, over JUnit 4; Kotlin/Native bundles its own kotlin.test.
JUNIT_TEST_DEPS = [
    "@maven_kotlinconf//:" + name
    for name in [
        "junit_junit",
        "org_jetbrains_kotlin_kotlin_test",
        "org_jetbrains_kotlin_kotlin_test_junit",
    ]
]

kt_multiplatform_test(
    name = "tests",
    size = "small",
    timeout = "short",
    srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    android = dict(manifest_values = {"minSdkVersion": "28"}),
    deps_android = JUNIT_TEST_DEPS,
    deps_jvm = JUNIT_TEST_DEPS,
    ios = dict(
        # KMPNotifier's iOS klib refers to FirebaseMessaging's FIRMessaging class; -ObjC and
        # -lsqlite3 match //app/iosApp:KotlinConf.
        linkopts = [
            "-ObjC",
            "-lsqlite3",
        ],
        minimum_os_version = "16.0",
        timeout = "moderate",
        deps = ["@swiftpkg_firebase_ios_sdk//:FirebaseMessaging"],
    ),
    ios_test_rule = ios_unit_test,
    library = ":shared",
    platforms = [
        "jvm",
        "android",
        "ios_simulator_arm64",
    ],
    srcs_jvm = glob(["src/jvmTest/kotlin/**/*.kt"]),
    deps = TEST_DEPS,
)
