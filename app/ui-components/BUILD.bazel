load("@rules_kotlin//kotlin:kmp.bzl", "kt_multiplatform_library")
load("//bazel:compose_resources.bzl", "compose_resources")

# The UI components of the apps: the theme, the Compose components and the UiRes resources, a Kotlin
# Multiplatform library for the JVM, Android and the iOS targets.

KMP = "@kmp_maven//:"

# The commonMain `api` dependencies: the consumers of the components see them too (the `exports` of
# the macro).
UI_COMPONENTS_API_DEPS = [
    KMP + name
    for name in [
        "org_jetbrains_compose_runtime_runtime",
        "org_jetbrains_compose_foundation_foundation",
        "org_jetbrains_compose_animation_animation",
        "org_jetbrains_compose_components_components_resources",
    ]
]

# The commonMain `implementation` dependencies.
UI_COMPONENTS_DEPS = [
    KMP + name
    for name in [
        "org_jetbrains_compose_material_material_ripple",
        "org_jetbrains_compose_ui_ui_tooling_preview",
        "io_coil_kt_coil3_coil_compose",
        "io_coil_kt_coil3_coil_network_ktor3",
        "io_coil_kt_coil3_coil_svg",
        "org_jetbrains_androidx_lifecycle_lifecycle_runtime_compose",
        "org_jetbrains_androidx_lifecycle_lifecycle_viewmodel_compose",
        "com_mikepenz_multiplatform_markdown_renderer",
    ]
]

# The Ktor engine of Coil's network loader: OkHttp on the JVM and Android, Darwin on iOS.
KTOR_OKHTTP = KMP + "io_ktor_ktor_client_okhttp"

KTOR_DARWIN = KMP + "io_ktor_ktor_client_darwin"

# The Compose resources of the UI components: a public `UiRes` class, so //app/shared and the apps
# use the icons, strings and fonts of the components.
compose_resources(
    name = "ui_components_resources",
    srcs = glob(["src/commonMain/composeResources/**"]),
    actual_srcs = [
        "android",
        "non_android",
    ],
    package = "org.jetbrains.kotlinconf.ui.generated.resources",
    public = True,
    res_class = "UiRes",
    resources_dir = "src/commonMain/composeResources",
    visibility = ["//app:__subpackages__"],
)

# The sources of the module, along the hierarchy and aliases of kt_multiplatform_library: each
# platform compiles the fragments of the groups, aliases and platform leaves that cover it, refined
# by platform inclusion.

# Every platform (the `srcs` of the macro): the commonMain code and the generated sources of the
# resources (the UiRes class, its accessors and the `expect` collectors).
COMMON = glob(["src/commonMain/kotlin/**/*.kt"]) + [":ui_components_resources_common_srcs"]

# The JVM and the native targets, not Android: Gradle's nonAndroidMain, the `actual` theme switch of
# the platforms without a Configuration, listed in `srcs_non_android` of the `non_android` alias.
NON_ANDROID = glob(["src/nonAndroidMain/kotlin/**/*.kt"])

# The Android sources alone: Gradle's androidMain, the `actual` theme switch of the Configuration.
ANDROID = glob(["src/androidMain/kotlin/**/*.kt"])

# The generated sources of the resources join the `srcs` of the macro (the UiRes class, its
# accessors and the `expect` collectors) and `srcs_android` and `srcs_non_android` (the `actual`
# collectors, partitioned across the two disjoint branches below `common` via distinct `actual_srcs`
# filegroups); the resource tree goes on the JVM classpath as a jar and into the Android assets,
# where the resources runtime reads it. The alias //app/ui-components:ui_components selects the
# variant of its consumer.
#
# The fragments the macro declares per targeted group, alias and platform leaf, refined by platform
# inclusion:
#   COMMON (the macro's `srcs`)                              common
#   NON_ANDROID + :ui_components_resources_non_android_srcs  non_android, refines common
# ANDROID + :ui_components_resources_android_srcs (`srcs_android`) is the leaf `android` (refining
# common); the leaves of the JVM and the konan targets are empty (refining non_android).
#
# The Android library is only built for an Android platform (android_binary transitions to
# //:arm64-v8a), where the @kmp_maven aliases select the Android variants of Compose and Coil;
# built for another platform it would get the desktop ones, so a build of the package skips it.
kt_multiplatform_library(
    name = "ui_components",
    srcs = COMMON,
    aliases = {
        "non_android": [
            "jvm",
            "ios_arm64",
            "ios_simulator_arm64",
        ],
    },
    android = dict(
        assets = [":ui_components_resources_files"],
        assets_dir = "ui_components_resources/resources",
        custom_package = "com.jetbrains.kotlinconf.ui",
        manifest = "src/androidMain/AndroidManifest.xml",
        target_compatible_with = ["@platforms//os:android"],
    ),
    deps_android = [KTOR_OKHTTP],
    deps_ios = [KTOR_DARWIN],
    deps_jvm = [KTOR_OKHTTP],
    jvm = dict(
        resource_jars = [":ui_components_resources_jar"],
    ),
    platforms = [
        "jvm",
        "android",
        "ios_arm64",
        "ios_simulator_arm64",
    ],
    plugins_android = ["//:compose_plugin"],
    plugins_jvm = ["//:compose_plugin"],
    plugins_native = ["//:compose_native_plugin"],
    srcs_android = ANDROID + [":ui_components_resources_android_srcs"],
    srcs_non_android = NON_ANDROID + [":ui_components_resources_non_android_srcs"],
    visibility = ["//visibility:public"],
    exports = UI_COMPONENTS_API_DEPS,
    deps = UI_COMPONENTS_API_DEPS + UI_COMPONENTS_DEPS,
)
