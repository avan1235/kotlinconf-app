# The Starlark of the build that is specific to this repository: compose_resources.bzl (the Compose
# Multiplatform resources of the app modules, generated by //bazel/compose_resources),
# google_services.bzl (the Firebase resources of the Android app, generated by //bazel/google_services
# from its google-services.json) and metro_compat.bzl (adapts the Metro compiler plugin jar for the
# Kotlin/Native 2.5.20-dev compiler release).

exports_files([
    "compose_resources.bzl",
    "google_services.bzl",
    "metro_compat.bzl",
])
