maven.artifact(coordinates = "androidx.core:core-splashscreen:1.2.0", platforms = _ANDROID)

# The desugar-deps corrections of the APK (row 16 of the experiment log): two jars whose Gradle
# metadata scopes their dependencies runtime-only — kotlinx-coroutines-play-services (on Android
# pulled only by firebase-common) and kaml (on Android pulled only by ktor-openapi-schema-jvm;
# the JVM keeps it through its ktor-server-* parents). The lock records the edges as runtime_deps
# only, the hub's jar targets then carry no compile deps, and Bazel's per-jar desugaring of the
# APK runs with an empty classpath: the desugarer records the interfaces the desugared lambdas
# need (CancellableContinuation, Job, Deferred; SerialDescriptor, SerializersModuleCollector)
# as missing in the jar's desugar_deps metadata, and the deploy jar's strict check rejects them
# because they have default methods. rules_kmp's maven extension has no tag to add edges (the
# old migration patched the same jars in the resolver through kmp_maven.install
# extra_dependencies), so the consumer cuts the transitive edge and re-imports the raw jar with
# the edges as compile deps in //app/androidApp — the proven markdown-renderer recipe of
# //app/ui-components. play-services is also re-declared as a root request: with the
# firebase-common edge cut it would otherwise drop out of the lock (no platform would pull it)
# and its http_file repo — the raw jar the re-import needs — with it.
maven.omit_dependency(
    module = "com.google.firebase:firebase-common",
    dependency = "org.jetbrains.kotlinx:kotlinx-coroutines-play-services",
)
maven.artifact(coordinates = "org.jetbrains.kotlinx:kotlinx-coroutines-play-services:1.11.0", platforms = _ANDROID)
maven.omit_dependency(
    module = "io.ktor:ktor-openapi-schema-jvm",
    dependency = "com.charleskorn.kaml:kaml",
)

