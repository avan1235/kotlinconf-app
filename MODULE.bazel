# The http_file repos of the raw artifacts the BUILD files re-import with restored dependency
# edges: the markdown renderer's Android AAR (//app/ui-components, its Gradle metadata declares
# the Compose deps compileOnly) and the two desugar-deps corrections of the APK
# (//app/androidApp, see the omit_dependency tags above). The hub's own targets own the jars
# with the lock's edges only, and rules_kmp's maven extension has no tag to add edges (the old
# migration used kmp_maven.install extra_dependencies).
use_repo(
    maven,
    "maven",
    "maven__com_mikepenz_multiplatform_markdown_renderer_android_0_39_2_multiplatform_markdown_renderer_aar",
    "maven__org_jetbrains_kotlinx_kotlinx_coroutines_play_services_1_11_0_kotlinx_coroutines_play_services_1_11_0_jar",
    "maven__com_charleskorn_kaml_kaml_jvm_0_79_0_kaml_jvm_0_79_0_jar",
)
