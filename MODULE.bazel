"""The Bazel build of the KotlinConf app, with the rules_kmp rules of voize-gmbh.

The modules are //core, //app/shared and //app/ui-components (kmp_library), //app/desktopApp and
//backend (kmp_jvm_module). The Maven lock of the @maven hub, //:maven_lock.json, is generated by
`bazel run @maven//:pin` and checked by `bazel run @maven//:pin_check`; the pinned Gradle of the
extension resolves every dependency for the platforms this build has — jvm, android, ios_arm64,
ios_simulator_arm64 — plus the tools platform (the embeddable compiler plugins of Kotlin/Native
and the KSP2 of rules_kmp's toolchain). js and wasmJs are out of scope (the webApp and adminApp
of the Gradle build are gone).
"""

module(name = "kotlinconf_app")

# rules_kmp is not on the Bazel Central Registry: the README pins a commit with git_override; this
# build consumes the Branch Deck lease checkout of the comparison experiment instead, so rules_kmp
# itself can be patched during the experiment (see notes/experiment_log.md of the comparison).
bazel_dep(name = "rules_kmp")
local_path_override(
    module_name = "rules_kmp",
    path = "/Users/maciej.procyk/.branch-deck/pool/rules_kmp-80e39f65/1/rules_kmp",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
# @platforms labels in the main BUILD file (the //:arm64-v8a platform of --android_platforms) need
# this as a direct bazel_dep of the main module — bzlmod repo mapping, same pin as the old migration.
bazel_dep(name = "platforms", version = "1.0.0")

# rules_shell, for the sh_test of //bazel/compose_resources/tests (bundle_test.sh) and the ipa_test
# of //app/iosApp: rules_kmp does not depend on it, so this direct bazel_dep makes @rules_shell
# visible to the main module.
bazel_dep(name = "rules_shell", version = "0.6.1")

# The iOS app (app/iosApp/BUILD.bazel): rules_apple bundles and signs it, rules_swift compiles its
# Swift sources, and rules_swift_package_manager builds the Firebase SDK from the Swift package of
# app/iosApp/Package.swift, pinned by app/iosApp/Package.resolved (the SwiftPM lock file; re-resolve
# it with `bazel run @swift_package//:resolve` after changing Package.swift). rules_xcodeproj
# generates an Xcode project from the Bazel targets (`bazel run //app/iosApp:xcodeproj`).
bazel_dep(name = "rules_apple", version = "5.4.0")
bazel_dep(name = "rules_swift", version = "4.2.2")
bazel_dep(name = "rules_swift_package_manager", version = "1.25.0")
# cc_library for the FirebaseMessaging version globals //app/iosApp defines (see
# app/iosApp/FirebaseMessagingVersion.c), the pin of rules_apple.
bazel_dep(name = "rules_cc", version = "0.2.17")

bazel_dep(name = "rules_xcodeproj", version = "4.1.0", dev_dependency = True)

swift_deps = use_extension("@rules_swift_package_manager//:extensions.bzl", "swift_deps")
swift_deps.from_package(
    resolved = "//app/iosApp:Package.resolved",
    swift = "//app/iosApp:Package.swift",
)
use_repo(swift_deps, "swift_package", "swiftpkg_firebase_ios_sdk")

# The Go SDK the build tools written in Go are compiled with: the Android tools of rules_android and
# the repository tools of gazelle, which rules_swift_package_manager brings in, fetch their Go
# dependencies. The SDK the root module declares comes first; without one, rules_go takes the one
# of rules_android (Go 1.22), too old for the gazelle release rules_swift_package_manager brings in
# (its tools need Go 1.24.12 or later). The version is the one rules_swift_package_manager declares.
bazel_dep(name = "rules_go", version = "0.60.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.0")

# java_import of the resource jars (kmp_library/kmp_jvm_module have no resource_jars attr): the
# main module can see @rules_java only as its own bazel_dep (examples/basic never needs it).
bazel_dep(name = "rules_java", version = "9.9.0")

# The Android SDK of the Android compilations, read from ANDROID_HOME like in the rules_kmp example
# (platform 37.0, the android-37.0 directory of the SDK). ANDROID_HOME must be set for every Bazel
# server that touches the Android build, the rules_xcodeproj generator's included: a server started
# without it (stale, from a shell that had none) sees a broken stub of this repository.
bazel_dep(name = "rules_android", version = "0.8.0")
android_sdk = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
use_repo(android_sdk, "androidsdk")

# The NDK of the android_binary of //app/androidApp: the binary needs a C++ toolchain for its
# Android split (the rules_cc implicit dependency of rules_android's android_binary) although the
# app has no native code. The old migration registered the hermetic NDK r29 for exactly this
# purpose (97d4a16c MODULE.bazel:74-106); this build stays with the local-SDK choice of the
# rules_kmp example pattern and registers the local NDK r27 of the same SDK home instead.
bazel_dep(name = "rules_android_ndk", version = "0.1.5", dev_dependency = True)

android_ndk_repository_extension = use_extension(
    "@rules_android_ndk//:extension.bzl",
    "android_ndk_repository_extension",
    dev_dependency = True,
)
android_ndk_repository_extension.configure(
    path = "/Users/maciej.procyk/Library/Android/sdk/ndk/27.0.12077973",
)
use_repo(android_ndk_repository_extension, "androidndk")

register_toolchains(
    "@androidndk//:all",
    dev_dependency = True,
)

# The compiler distribution of the toolchain of rules_kmp (the serialization and compose plugin
# jars of the root BUILD.bazel come from it).
kotlin = use_extension("@rules_kmp//kotlin:extensions.bzl", "kotlin")
use_repo(kotlin, "kotlin_compiler")

# The Maven dependencies of the app, resolved per platform by the pinned Gradle of the extension
# (see maven/pin). The lock tag is what generates the @maven hub (with its pin and pin_check
# targets) even before the first pin: before //:maven_lock.json exists the hub has no artifacts,
# and `bazel run @maven//:pin` writes the lock the hub then exposes.
maven = use_extension("@rules_kmp//maven:extension.bzl", "maven")
# kmpnotifier's iOS klibs link the FirebaseMessaging pod (maven_lock.json link_pods): rules_kmp
# requires the consumer's link_<pod>_<platform> targets (NativeLinkInfo providers, see
# maven/extension.bzl:255 + maven/import.bzl:103) — the pass-2 targets of the SwiftPM-built
# Firebase live in the root package.
maven.lock(
    file = "//:maven_lock.json",
    jvm_version = 21,
    link_pods_package = "//:BUILD.bazel",
)
maven.repository(
    name = "central",
    url = "https://repo1.maven.org/maven2",
)
maven.repository(
    name = "google",
    url = "https://dl.google.com/dl/android/maven2",
)

# The platforms of the declarations: the targets of this build and the tools platform.
_ALL = ["jvm", "android", "ios_arm64", "ios_simulator_arm64"]
_JVM = ["jvm"]
_ANDROID = ["android"]
_IOS = ["ios_arm64", "ios_simulator_arm64"]
_TOOLS = ["tools"]

