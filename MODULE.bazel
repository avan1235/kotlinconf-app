maven.artifact(coordinates = "org.jetbrains.skiko:skiko-awt-runtime-macos-arm64:0.150.1", platforms = _JVM, scope = "runtime")
maven.artifact(coordinates = "org.jetbrains.skiko:skiko-awt-runtime-linux-x64:0.150.1", platforms = _JVM, scope = "runtime")

